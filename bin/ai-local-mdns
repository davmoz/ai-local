#!/bin/bash
# Publishes "ai.local" (A record + _http._tcp service) via Bonjour, pointing at this
# Mac's current LAN address. Re-registers when the address changes.
# Started by launchd (local.ai.mdns).
set -uo pipefail

HOSTNAME_FQDN="ai.local"
PORT="${AI_LOCAL_PORT:-80}"

current_ip() {
  local ifc
  ifc=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
  [[ -n "$ifc" ]] && ipconfig getifaddr "$ifc" 2>/dev/null
}

child=""
cleanup() { [[ -n "$child" ]] && kill "$child" 2>/dev/null; exit 0; }
trap cleanup TERM INT

registered=""
while true; do
  ip=$(current_ip || true)
  if [[ -n "$ip" && "$ip" != "$registered" ]] || { [[ -n "$child" ]] && ! kill -0 "$child" 2>/dev/null; }; then
    [[ -n "$child" ]] && kill "$child" 2>/dev/null && wait "$child" 2>/dev/null
    child=""
    if [[ -n "$ip" ]]; then
      echo "$(date '+%F %T') registering $HOSTNAME_FQDN -> $ip:$PORT"
      /usr/bin/dns-sd -P "AI" _http._tcp local "$PORT" "$HOSTNAME_FQDN" "$ip" path=/ &
      child=$!
      registered="$ip"
    fi
  fi
  sleep 30
done
